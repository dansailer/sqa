#!/bin/sh
# Fake `sonar` CLI for sqa tests. Serves recorded responses from $FAKE_SONAR_DIR
# and logs every invocation (one argv per line, args separated by \x1f) to
# $FAKE_SONAR_LOG.
set -eu
d="${FAKE_SONAR_DIR:?}"
if [ -n "${FAKE_SONAR_LOG:-}" ]; then
  printf '%s' "$1" >>"$FAKE_SONAR_LOG"
  i=0
  for a in "$@"; do
    if [ $i -gt 0 ]; then printf '\037%s' "$a" >>"$FAKE_SONAR_LOG"; fi
    i=$((i + 1))
  done
  printf '\n' >>"$FAKE_SONAR_LOG"
fi
if [ -n "${FAKE_SONAR_ENVLOG:-}" ]; then
  printf '%s|%s|%s\n' "$1" "${SONARQUBE_CLI_KEYCHAIN_FILE-<unset>}" "${SONAR_USER_HOME-<unset>}" >>"$FAKE_SONAR_ENVLOG"
fi
case "$1" in
  --version) echo "1.12.0"; exit 0 ;;
  auth)
    if [ "$2" = status ]; then
      if [ -n "${FAKE_AUTH_STDERR:-}" ]; then echo "$FAKE_AUTH_STDERR" >&2; exit 1; fi
      cat "$d/auth_status.json"; exit "${FAKE_AUTH_EXIT:-0}"
    fi
    if [ "$2" = login ] && [ -n "${FAKE_WRITE_CREDS:-}" ]; then
      # Simulate a store that replaces the file with a world-readable one.
      rm -f "$SONARQUBE_CLI_KEYCHAIN_FILE"
      (umask 022; printf '{"tokens":{}}' >"$SONARQUBE_CLI_KEYCHAIN_FILE")
    fi
    echo "auth $2 passthrough"; exit 0 ;;
  list)
    newcode=0; project=0
    for a in "$@"; do
      [ "$a" = "--new-code" ] && newcode=1
      [ "$a" = "--project" ] && project=1
    done
    if [ $project -eq 0 ]; then
      if [ -n "${FAKE_NO_PROJECT:-}" ]; then
        printf '%s\n' "Could not determine project key." "  -> Use --project <key>, or run 'sonar link <projectKey>'" >&2
        exit 1
      fi
      echo "Using auto-detected project key: demo" >&2
    fi
    case " $* " in
      *" --branch "*|*" --pull-request "*) ;;
      *) if [ -n "${FAKE_DETECT_PR:-}" ]; then echo "Using pull request ${FAKE_DETECT_PR} (auto-detected from CI)" >&2; fi ;;
    esac
    if [ $newcode -eq 1 ]; then cat "$d/issues_newcode.json"; else cat "$d/issues.json"; fi
    exit 0 ;;
  api)
    method="$2"; path="$3"
    if [ "$method" = post ]; then
      if [ -n "${FAKE_POST_FAIL:-}" ]; then echo "SonarQube API error: 403 - forbidden" >&2; exit 1; fi
      exit 0
    fi
    case "$path" in
      /api/server/version*) cat "$d/server_version.txt" ;;
      /api/hotspots/search*resolution=ACKNOWLEDGED*)
        # Acknowledged hotspots only when a test sets FAKE_ACK; never on new code.
        case "$path" in
          *inNewCodePeriod=true*) echo '{"paging":{"pageIndex":1,"pageSize":500,"total":0},"hotspots":[],"components":[]}' ;;
          *) if [ -n "${FAKE_ACK:-}" ]; then cat "$d/hotspots_ack.json"; else echo '{"paging":{"pageIndex":1,"pageSize":500,"total":0},"hotspots":[],"components":[]}'; fi ;;
        esac ;;
      /api/hotspots/search*inNewCodePeriod=true*) cat "$d/hotspots_newcode.json" ;;
      /api/hotspots/search*) cat "$d/hotspots.json" ;;
      /api/hotspots/show*)
        case "$path" in
          *hotspot=HS-1*) cat "$d/hotspot_show.json" ;;
          *hotspot=HS-500*) echo "SonarQube API error: 500 - {\"errors\":[{\"msg\":\"search timed out after 404 ms\"}]}" >&2; exit 1 ;;
          *hotspot=HS-ACK*) sed -e 's/"key": "HS-1"/"key": "HS-ACK"/' -e 's/"status": "TO_REVIEW"/"status": "REVIEWED", "resolution": "ACKNOWLEDGED"/' "$d/hotspot_show.json" ;;
          *) echo "SonarQube API error: 404 - {\"errors\":[{\"msg\":\"Hotspot not found\"}]}" >&2; exit 1 ;;
        esac ;;
      /api/issues/search*issues=AX-VULN-OLD*) sed 's/"AX-VULN"/"AX-VULN-OLD"/' "$d/issue_vuln.json" ;;
      /api/issues/search*issues=AX-VULN*) cat "$d/issue_vuln.json" ;;
      /api/issues/search*) echo '{"total":0,"p":1,"ps":100,"paging":{"pageIndex":1,"pageSize":100,"total":0},"issues":[],"components":[]}' ;;
      /api/rules/show*) cat "$d/rule_show.json" ;;
      /api/sources/lines*from=*) cat "$d/sources_lines.json" ;;
      /api/sources/lines*)
        if [ -n "${FAKE_NO_LINEHITS:-}" ]; then cat "$d/sources_lines.json"; else cat "$d/sources_coverage.json"; fi ;;
      /api/qualitygates/project_status*)
        case "${FAKE_GATE:-}" in
          nocov) cat "$d/gate_status_nocov.json" ;;
          fail) echo "SonarQube API error: 404 - {\"errors\":[{\"msg\":\"Project has not been analyzed yet\"}]}" >&2; exit 1 ;;
          *) cat "$d/gate_status.json" ;;
        esac ;;
      /api/measures/component_tree*'&s=metricPeriod'*) cat "$d/tree_newcode.json" ;;
      /api/measures/component_tree*) cat "$d/tree_overall.json" ;;
      /api/measures/component*component=demo%3Ainternal%2Fapi%2Fusers.go*) cat "$d/measures_file.json" ;;
      /api/measures/component*component=demo%3Ainternal%2Fapi\&*) cat "$d/measures_dir.json" ;;
      /api/measures/component*component=demo%3A*) echo "SonarQube API error: 404 - {\"errors\":[{\"msg\":\"Component key not found\"}]}" >&2; exit 1 ;;
      /api/measures/component*)
        if [ -n "${FAKE_NO_NEWCODE:-}" ]; then cat "$d/measures_project_overall.json"; else cat "$d/measures_project.json"; fi ;;
      *) echo "SonarQube API error: 404 - unknown $path" >&2; exit 1 ;;
    esac
    exit 0 ;;
  integrate) echo "integrate must never be called" >&2; exit 99 ;;
esac
echo "fake sonar: unsupported args: $*" >&2
exit 2
